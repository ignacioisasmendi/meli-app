// Mercado Libre Multi-Account Inventory & Operations System
// Postgres (Supabase) + Prisma with the pg driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PurchaseStatus {
  PURCHASED
  IN_USA
  IN_TRANSIT
  CUSTOMS
  WAREHOUSE
  AVAILABLE
}

enum BatchStatus {
  PURCHASED
  IN_USA
  IN_TRANSIT
  CUSTOMS
  WAREHOUSE
  AVAILABLE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RESERVE
  RELEASE
  RETURN
}

/// Lifecycle of a physical box travelling USA → Argentina.
enum ShipmentStatus {
  OPEN
  IN_TRANSIT
  ARRIVED
  COSTED
}

/// How a shipment's freight bill is split across the batches inside it.
enum AllocationBasis {
  WEIGHT
  VALUE
  UNITS
}

/// What became of a sale after it was recorded.
///
/// The three "money is going back" states differ only in what happens to the
/// units, which is the whole reason they are separate:
///   CANCELLED      — killed before it shipped, so the units never left and go
///                    straight back to sellable stock.
///   RETURN_PENDING — buyer is sending it back. Revenue is reversed now; stock
///                    stays out until the box is physically in hand, so we
///                    can't oversell something still in the mail.
///   REFUNDED       — buyer was refunded but nothing comes back (ML sometimes
///                    refunds and lets them keep the item). Money out, no stock.
/// RETURNED is the terminal state of RETURN_PENDING once goods are received.
enum SaleStatus {
  CONFIRMED
  CANCELLED
  RETURN_PENDING
  RETURNED
  REFUNDED
}

/// Which pipeline booked a sale. Both run the same stock/profit code; the source
/// is kept so the two can be compared while the report import is being trusted.
///   WEBHOOK — ML notified an order and `processOrder` read it from the API.
///   REPORT  — booked from a row of ML's downloadable sales report.
enum SaleSource {
  WEBHOOK
  REPORT
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// A box sent from the local depot to a Mercado Libre Full warehouse.
///   SENT     — created in the CRM with the inbound ID Mercado Libre assigned
///              in the seller panel; physically on its way.
///   RECEIVED — `syncFullShipmentReceptions` found a matching INBOUND_RECEPTION
///              operation on ML's side (or it was confirmed by hand).
enum FullShipmentStatus {
  SENT
  RECEIVED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  auth0Sub  String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  mlAccounts MercadoLibreAccount[]

  @@map("users")
}

model MercadoLibreAccount {
  id           String   @id @default(cuid())
  nickname     String
  mlUserId     String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales         Sale[]
  listings      MlListing[]
  fullShipments FullShipment[]
  salesReports  SalesReport[]

  @@map("mercadolibre_accounts")
}

// ---------------------------------------------------------------------------
// Catalog & inventory
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  brand          String?
  currentStock   Int      @default(0)
  reservedStock  Int      @default(0)
  totalPurchased Int      @default(0)
  totalSold      Int      @default(0)
  averageCostUsd Float    @default(0)
  minStock       Int      @default(5)
  archived       Boolean  @default(false)
  /// Shipping weight of ONE unit, in grams. Drives weight-based freight
  /// allocation; when any product in a shipment is missing it, that shipment
  /// falls back to allocating by value.
  weightGrams    Float?
  /// Identification thumbnail. Backfilled from the linked ML listing's first
  /// picture by `syncAccountListings`, which only ever fills a NULL — so a
  /// hand-picked image is never overwritten by a later sync. Purely cosmetic:
  /// nothing in stock or costing reads it.
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases  Purchase[]
  batches    InventoryBatch[]
  sales      Sale[]
  movements  InventoryMovement[]
  listings   MlListing[]
  candidates OpportunityCandidate[]

  @@index([archived])
  @@map("products")
}

/// One order placed with a supplier (an Amazon order, typically), grouping the
/// per-product `Purchase` lines it was split into.
///
/// It also keeps the order-level extras the supplier charged once for the whole
/// basket — tax and shipping — which `allocateLandedCosts` spreads over the
/// lines by value at import time. Storing them here is what makes the split
/// explainable afterwards: the order total is the sum you actually paid, and
/// every line can show how much of it landed on that product.
model PurchaseOrder {
  id          String   @id @default(cuid())
  /// The supplier's own order number, as printed on the invoice.
  orderNumber String
  supplier    String
  /// Order-level tax, already allocated across `purchases`.
  taxUsd      Float    @default(0)
  /// Order-level shipping & handling (net of any free-shipping discount),
  /// already allocated across `purchases`. This is the SUPPLIER's shipping —
  /// the USA → Argentina courier bill lives on `Shipment`.
  shippingUsd Float    @default(0)
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@unique([supplier, orderNumber])
  @@index([purchasedAt])
  @@map("purchase_orders")
}

/// Where an `ImportDraft` stands. Only PENDING drafts show up for review.
enum ImportDraftStatus {
  PENDING
  IMPORTED
  DISCARDED
}

/// A supplier order captured outside the app (the browser extension on an
/// Amazon "Order Details" page) and already read into purchase lines, waiting
/// for a human to review it. Nothing here touches stock or cost: the review
/// page pre-fills the normal import form, and `importPurchases` does the rest.
model ImportDraft {
  id          String            @id @default(cuid())
  /// What captured it — "extension" for now.
  source      String
  supplier    String
  /// As read off the page; null when it couldn't be.
  orderNumber String?
  /// The page the order was captured from, so it can be reopened.
  sourceUrl   String?
  status      ImportDraftStatus @default(PENDING)
  /// The `ParsedOrder` read off the page.
  order       Json
  /// `OrderWarning[]` from `reconcileOrder` — totals that didn't add up.
  warnings    Json
  /// Product links found on the page (`{ asin, title }[]`), kept so a later
  /// import can map a re-ordered ASIN straight onto its product.
  pageItems   Json?
  importedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([supplier, orderNumber])
  @@map("import_drafts")
}

model Purchase {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The supplier order this line came from. Null for one-off purchases
  /// registered by hand, which are an order of one.
  orderId      String?
  order        PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity     Int
  /// Supplier price for ONE unit, before the order's tax & shipping.
  unitPriceUsd Float          @default(0)
  /// This line's share of the order's tax, for the whole line (not per unit).
  /// Stored rather than derived: `unitCostUsd` below is overwritten with the
  /// freight-inclusive figure when the shipment is costed, so the only way the
  /// price/tax split survives is to keep it on the record.
  taxUsd       Float          @default(0)
  /// This line's share of the order's shipping, for the whole line. The
  /// SUPPLIER's shipping — USA → Argentina freight lives on the batch.
  shippingUsd  Float          @default(0)
  /// Cost of one unit for FIFO and profit: price + tax + shipping at import
  /// time, then rewritten by `costShipment` with import freight folded in.
  /// `unitPriceUsd + taxUsd + shippingUsd` is what the supplier billed, and
  /// stays put; this one moves.
  unitCostUsd  Float
  totalCostUsd Float
  supplier     String?
  invoiceUrl   String?
  status       PurchaseStatus @default(PURCHASED)
  purchasedAt  DateTime       @default(now())
  /// When the goods physically arrived. Goods from one order don't always land
  /// together, so a partial arrival splits the line (see `registerArrival`):
  /// every row carries a single date, never "some of it on each".
  arrivedAt    DateTime?
  /// When the goods are EXPECTED at the courier — a guess entered at import
  /// and revised by hand. Purely informational: unlike `arrivedAt` it never
  /// moves status or stock.
  estimatedArrivalAt DateTime?
  createdAt    DateTime       @default(now())

  batches InventoryBatch[]

  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@map("purchases")
}

/// Every purchase creates a batch. Batches are the source of truth for unit
/// cost (FIFO) and for "in transit" quantities until they become AVAILABLE.
///
/// Cost is stored in components so import freight can be folded in later,
/// once the box lands and the courier bill is known:
///   unitCostUsd (landed) = goodsUnitCostUsd + freightUnitCostUsd
/// `unitCostUsd` stays the figure FIFO and profit math read, so the same batch
/// of a product can carry a different landed cost in every shipment.
model InventoryBatch {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseId         String?
  purchase           Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  shipmentId         String?
  shipment           Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  /// The Full inbound these units left the local depot in. Set per batch, not
  /// per shipment, because a Full box takes whatever quantity of each product
  /// is going — so `allocateToFull` splits a batch when only part of it goes,
  /// and `quantity` on a Full batch is exactly the units sent.
  fullShipmentId     String?
  fullShipment       FullShipment? @relation(fields: [fullShipmentId], references: [id], onDelete: SetNull)
  /// In Full without a `FullShipment` — stock that was already there when it
  /// was loaded or marked by hand. On-hand batches count as in Full when they
  /// have a Full box OR this flag.
  placedInFull       Boolean       @default(false)
  quantity           Int
  remainingQuantity  Int
  /// Supplier price + that line's share of the supplier's own tax/shipping.
  goodsUnitCostUsd   Float         @default(0)
  /// This unit's share of the USA → Argentina freight bill.
  freightUnitCostUsd Float         @default(0)
  /// Landed cost = goods + freight. What FIFO consumes.
  unitCostUsd        Float
  /// True while `freightUnitCostUsd` comes from a shipment estimate rather
  /// than the actual courier bill.
  freightIsEstimate  Boolean       @default(false)
  status             BatchStatus   @default(PURCHASED)
  purchasedAt        DateTime      @default(now())

  saleConsumptions SaleBatchConsumption[]

  @@index([productId])
  @@index([status])
  @@index([shipmentId])
  @@index([fullShipmentId])
  @@map("inventory_batches")
}

/// A physical box travelling USA → Argentina. Groups the batches that ship
/// together so the courier bill — unknown until the box lands — can be split
/// across them and folded into each unit's landed cost.
model Shipment {
  id                String          @id @default(cuid())
  code              String          @unique
  courier           String?
  status            ShipmentStatus  @default(OPEN)
  basis             AllocationBasis @default(WEIGHT)
  /// Rough up-front guess, so in-transit goods can be priced before the bill
  /// arrives. Superseded by the actuals below at costing time.
  estimatedUsd      Float           @default(0)
  freightUsd        Float?
  customsUsd        Float?
  otherUsd          Float?
  /// Domestic delivery once the box is in the country. Billed in pesos, so it
  /// is entered in ARS and converted at costing time. The rate used is frozen
  /// on the shipment (`localShippingRate`) and the converted figure stored
  /// (`localShippingUsd`) — otherwise re-costing later, at a different rate,
  /// would silently move landed costs that are already booked.
  localShippingArs  Float?
  localShippingUsd  Float?
  localShippingRate Float?
  notes             String?
  departedAt        DateTime?
  arrivedAt         DateTime?
  costedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  batches InventoryBatch[]

  @@index([status])
  @@map("shipments")
}

/// A physical box of received stock sent on to a Mercado Libre Full warehouse,
/// built product by product from what is on hand at the local depot. There is no API to create the
/// inbound request itself — that happens by hand in ML's seller panel, which
/// hands back `mlInboundId`. `syncFullShipmentReceptions` (run on a cron)
/// polls `/stock/fulfillment/operations/search` for an INBOUND_RECEPTION
/// operation whose `external_references` carry that same id, and that is what
/// flips this to RECEIVED.
model FullShipment {
  id          String              @id @default(cuid())
  accountId   String
  account     MercadoLibreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Pasted in from Mercado Libre's seller panel when the inbound is created.
  mlInboundId String
  status      FullShipmentStatus  @default(SENT)
  sentAt      DateTime            @default(now())
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  batches InventoryBatch[]

  @@unique([accountId, mlInboundId])
  @@index([status])
  @@map("full_shipments")
}

/// Maps a Mercado Libre listing (item) on a given account to an internal Product.
model MlListing {
  id          String              @id @default(cuid())
  accountId   String
  account     MercadoLibreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mlItemId    String
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku         String?
  title       String?
  /// This item's id in ML's Full inventory system, fetched lazily from
  /// `GET /items/$ITEM_ID` the first time a Full shipment needs to look up
  /// stock operations for it. Null for listings that never touched Full.
  inventoryId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([accountId, mlItemId])
  @@index([productId])
  @@map("ml_listings")
}

// ---------------------------------------------------------------------------
// Sales & movements
// ---------------------------------------------------------------------------

/// A sale mirrors an ML order. `quantity` / `salePriceArs` / `feeArs` /
/// `shippingArs` / `profitUsd` are the GROSS figures as ML reported them and are
/// never rewritten — a cancellation or return is recorded alongside them in the
/// `reversed*` / `refunded*` columns instead.
///
/// That split is what lets every aggregate stay a single query: net revenue is
/// `SUM(salePriceArs) - SUM(refundedArs)` and net profit is
/// `SUM(profitUsd) - SUM(reversedProfitUsd)`, so adding a reversal never means
/// re-reading rows to correct them. See `netRevenueArs` in `lib/inventory/returns.ts`.
model Sale {
  id             String              @id @default(cuid())
  mlOrderId      String              @unique
  /// The number ML shows the seller as "Venta #": the pack id when the buyer
  /// checked out a cart (one pack, several orders), the order id otherwise.
  saleNumber     String
  accountId      String
  account        MercadoLibreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  salePriceArs   Float
  /// The payout breakdown, read from the Mercado Pago payment's
  /// `charges_details` rather than the order: the order only knows the ML fee,
  /// its `shipping_cost` is what the BUYER paid, and it has no taxes at all.
  /// ML's selling fee.
  feeArs         Float               @default(0)
  /// Shipping charged to the seller, not what the buyer paid.
  shippingArs    Float               @default(0)
  /// Taxes withheld by Mercado Pago (e.g. the IIBB retention).
  taxArs         Float               @default(0)
  /// What actually lands in the account: `net_received_amount`. Stored as ML
  /// reports it, not derived, because a payment can carry charge types beyond
  /// fee/shipping/tax. `profitUsd` is computed from this.
  netReceivedArs Float               @default(0)
  profitUsd      Float               @default(0)
  /// FIFO cost of goods sold, as `applySale` valued it at sale time. Stored
  /// because it can't be recovered later: batches get re-costed and the USD/ARS
  /// rate moves, so a refund-without-return months on would otherwise have to
  /// guess what these units cost.
  costUsd        Float               @default(0)
  soldAt         DateTime
  createdAt      DateTime            @default(now())
  source         SaleSource          @default(WEBHOOK)

  status            SaleStatus @default(CONFIRMED)
  /// Units reversed so far. Less than `quantity` on a partial return.
  returnedQuantity  Int        @default(0)
  /// Units already back on the shelf. Trails `returnedQuantity` while goods are
  /// in the mail, and stays behind it permanently for a write-off.
  restockedQuantity Int        @default(0)
  /// Gross revenue handed back to the buyer.
  refundedArs       Float      @default(0)
  /// Profit backed out of reporting.
  reversedProfitUsd Float      @default(0)
  /// The ML claim that triggered this, when it came from post-purchase rather
  /// than an outright order cancellation.
  mlClaimId         String?
  reversalReason    String?
  reversedAt        DateTime?

  consumptions SaleBatchConsumption[]

  @@index([accountId])
  @@index([productId])
  @@index([soldAt])
  @@index([status])
  @@index([mlClaimId])
  @@index([saleNumber])
  @@map("sales")
}

/// One upload of ML's sales report ("Ventas" → Descargar Excel/CSV) for an
/// account. Rows are kept rather than applied on upload, so the report can be
/// compared against what the webhook pipeline booked before anything changes —
/// the comparison itself is computed on read, against the live sales table.
model SalesReport {
  id          String              @id @default(cuid())
  accountId   String
  account     MercadoLibreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName    String
  /// "Estado de tus ventas al …" — the moment the report reflects.
  generatedAt DateTime?
  rowCount    Int
  uploadedAt  DateTime            @default(now())

  rows SalesReportRow[]

  @@index([accountId])
  @@map("sales_reports")
}

/// A line of the report, trimmed to what reconciliation needs (no DNI or
/// addresses). Money is as ML prints it: charges and refunds are negative.
model SalesReportRow {
  id                String      @id @default(cuid())
  reportId          String
  report            SalesReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rowNumber         Int
  saleNumber        String
  soldAt            DateTime
  status            String
  statusDetail      String?
  quantity          Int
  unitPriceArs      Float?
  productRevenueArs Float
  feeArs            Float
  taxArs            Float
  shippingIncomeArs Float
  shippingCostArs   Float
  otherChargesArs   Float
  refundsArs        Float
  totalArs          Float
  mlItemId          String?
  title             String?
  variant           String?
  sku               String?
  buyerName         String?
  returnResult      String?
  /// Last time "apply" acted on this row, and what it did — an audit trail, not
  /// a guard: reconciliation re-derives what's left to do from the sales table.
  appliedAt         DateTime?
  applyNote         String?

  @@index([reportId])
  @@index([saleNumber])
  @@map("sales_report_rows")
}

/// Which batches a sale actually consumed, and at what landed cost.
///
/// `applySale` walks batches FIFO and then forgets which ones it touched. That
/// is fine until stock has to come *back*: putting returned units on the wrong
/// batch would silently rewrite COGS, because batches of the same product carry
/// different landed costs. Recording the split makes a reversal exact — and
/// doubles as the per-sale COGS audit trail.
model SaleBatchConsumption {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity         Int
  /// Frozen copy of the batch's landed cost at consumption time, so reversal
  /// value survives the batch being re-costed or deleted.
  unitCostUsd      Float
  /// Units of this line already restored.
  restoredQuantity Int             @default(0)
  createdAt        DateTime        @default(now())

  @@index([saleId])
  @@index([batchId])
  @@map("sale_batch_consumptions")
}

/// Audit log of every stock change. `referenceType`/`referenceId` point at the
/// originating Purchase / Sale / adjustment.
model InventoryMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Integration plumbing
// ---------------------------------------------------------------------------

/// Idempotent log of incoming ML webhook notifications.
///
/// Deduped on `(topic, resource, sentAt)` rather than `(topic, resource)`. ML
/// re-notifies the *same* resource on every state change — `/orders/123` fires
/// again when that order is cancelled — so keying on the resource alone made a
/// processed sale deafen us to its own cancellation. `sent` is stable across
/// ML's delivery retries but differs per state change, which is exactly the
/// line we want to dedupe on.
model WebhookEvent {
  /// `topic|resource|sent`. A single non-null column rather than a compound
  /// unique over `sentAt`, because Postgres treats NULLs as distinct — a
  /// nullable member would make the constraint stop deduping exactly for the
  /// payloads that omit `sent`.
  dedupeKey   String        @unique
  id          String        @id @default(cuid())
  topic       String
  resource    String
  /// The notification's own `sent` timestamp, kept for debugging delivery order.
  sentAt      DateTime?
  mlUserId    String?
  status      WebhookStatus @default(RECEIVED)
  payload     Json
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([topic, resource])
  @@map("webhook_events")
}

/// Records cron runs (token refresh, daily summary) for observability / idempotency.
model JobRun {
  id         String    @id @default(cuid())
  name       String
  status     JobStatus @default(RUNNING)
  detail     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([name])
  @@map("job_runs")
}

/// Key/value app settings (e.g. usdArsRate override).
model Setting {
  key   String @id
  value String

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Sourcing — candidate products to import
// ---------------------------------------------------------------------------

/// What became of a candidate after it was evaluated.
enum OpportunityStatus {
  /// Cleared the margin filter and is waiting to be looked at.
  NEW
  /// Worth importing — kept out of the noise on later scans.
  SHORTLISTED
  /// Not worth it. `rejectedReason` says why, so a re-scan doesn't
  /// re-litigate the same product every week.
  REJECTED
  /// Turned into a real purchase; `productId` points at the catalog entry.
  IMPORTED
}

/// A product being considered for import, with the numbers it was judged on.
///
/// The whole cost breakdown is snapshotted rather than recomputed on read, for
/// the same reason a shipment freezes `localShippingRate`: the FX rate, the
/// freight rate and ML's fee all move, and a candidate has to stay explainable
/// as of the day it was scored. `PriceObservation` carries the moving picture.
model OpportunityCandidate {
  id       String  @id @default(cuid())
  asin     String?
  title    String
  brand    String
  model    String?
  /// Normalized `brand + model`, the dedupe key. Two listings that differ only
  /// in wording, colour or capacity collapse onto the same value.
  modelKey String

  // ── Source side (Amazon) ──
  amazonPriceUsd Float
  amazonTaxUsd   Float @default(0)
  weightGrams    Float

  // ── Sale side (Mercado Libre) ──
  mlPriceArs   Float
  mlSoldQty    Int?
  mlPermalink  String?
  mlCategoryId String?

  // ── The snapshot the verdict was based on ──
  usdArsRate        Float
  freightUsdPerKg   Float
  freightUsd        Float
  landedUsd         Float
  mlFeeRate         Float
  mlFeeArs          Float
  mlShippingCostArs Float @default(0)
  netProfitUsd      Float
  roiPct            Float
  breakEvenMlArs    Float

  status         OpportunityStatus @default(NEW)
  rejectedReason String?
  /// Set when this candidate is already something we stock.
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  scannedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations PriceObservation[]

  @@unique([modelKey])
  @@index([status])
  @@index([roiPct])
  @@index([scannedAt])
  @@map("opportunity_candidates")
}

/// One reading of a candidate's prices, kept so a scan can tell a durable margin
/// from a one-day Amazon promo — the question a spreadsheet row can never answer.
model PriceObservation {
  id          String               @id @default(cuid())
  candidateId String
  candidate   OpportunityCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  amazonPriceUsd Float
  mlPriceArs     Float
  netProfitUsd   Float
  roiPct         Float
  observedAt     DateTime @default(now())

  @@index([candidateId, observedAt])
  @@map("price_observations")
}
