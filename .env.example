# ── App ────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3002
NODE_ENV=development

# ── Auth0 ──────────────────────────────────────────────────────────────────
# AUTH0_SECRET: generate with `openssl rand -hex 32`
AUTH0_SECRET=
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# DATABASE_URL: pooled connection (PgBouncer, port 6543) used at runtime.
# DIRECT_URL:   direct connection (port 5432) used by `prisma migrate`.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Mercado Libre OAuth ────────────────────────────────────────────────────
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3002/api/mercadolibre/callback

# ── Cron / jobs ────────────────────────────────────────────────────────────
# CRON_SECRET: shared secret required in the Authorization header of /api/cron/*
CRON_SECRET=

# ── Currency ───────────────────────────────────────────────────────────────
# Default USD/ARS rate; can be overridden at runtime via the Settings table.
USD_ARS_RATE=1000
